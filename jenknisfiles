pipeline {
    agent any
    stages {
        stage('Clone Repository') {
            steps {
                // Clone the repository
                git branch: 'master', url: 'https://github.com/roy24991/roy-shir'
            }
        }
        stage('Hello World') {
            steps {
                // Print Hello World
                echo 'Hello World'
            }
        }
        stage('Run Python Script') {
            steps {
                // Run the Python script
                sh 'python3 path/to/your_script.py || python path/to/your_script.py'
            }
        }
    }
}
